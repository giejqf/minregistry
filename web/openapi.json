  "components": {
    "schemas": {
      "AuditActionsResponse": {
        "type": "object",
        "required": [
          "actions"
        ],
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuditEventSummary": {
        "type": "object",
        "required": [
          "id",
          "ts",
          "action",
          "outcome",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ts": {
            "type": "string"
          },
          "principal_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "principal_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string"
          },
          "repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_agent": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "$ref": "#/components/schemas/AuditOutcome"
          },
          "detail": {
            "type": "object"
          }
        }
      },
      "AuditListResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEventSummary"
            },
            "description": "Newest first."
